{
  "manifest_version": 3,
  "name": "메이플 환산 아이템메이커 브릿지",
  "version": "1.1.0",
  "description": "메이플스토리 웹 경매장 찜 목록을 환산 주스탯 사이트로 내보내고, 환산기 스펙업 순서를 분석합니다.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "*://*.nexon.com/*",
    "*://*.maplescouter.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.nexon.com/*"],
      "js": ["src/auction_content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.maplescouter.com/*"],
      "js": ["src/scouter_content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/auction_inject.js"],
      "matches": ["*://*.nexon.com/*"]
    },
    {
      "resources": ["src/scouter_inject.js"],
      "matches": ["*://*.maplescouter.com/*"]
    }
  ],
  "action": {
    "default_popup": "src/popup.html"
  }
}